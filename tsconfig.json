{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["shared/src/*"],
      "@services/*": ["services/src/*"],
      "@core/*": ["core/src/*"],
      "@bridge/*": ["bridge/src/*"],
      "@agent/*": ["agent/src/*"],
      "@commands/*": ["commands/src/*"],
      "@storage/*": ["storage/src/*"]
    }
  }
}
